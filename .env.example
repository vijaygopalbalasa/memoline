# apps/web
DATABASE_URL=
SESSION_SECRET=
WALLETCONNECT_PROJECT_ID=
# Set to 1 only for secret-less CI builds (`next build` without a real WALLETCONNECT_PROJECT_ID) —
# a placeholder id ships instead and WalletConnect/mobile wallets will not work. Never set this in
# a real production build.
ALLOW_PLACEHOLDER_WALLETCONNECT=
CHAIN_ENV=testnet
ARC_RPC_PRIMARY=https://rpc.mainnet.arc.io
# dRPC's free tier caps eth_getLogs ranges at roughly 100 blocks in practice (its own error message
# claims a much larger 10,000-block limit, which is wrong) — unsuitable as a history-fetching
# fallback. Use QuickNode instead.
ARC_RPC_FALLBACK=https://rpc.quicknode.mainnet.arc.io
ARC_TESTNET_RPC_PRIMARY=https://rpc.testnet.arc.io
ARC_TESTNET_RPC_FALLBACK=https://rpc.quicknode.testnet.arc.io
RPC_USER_AGENT=memoline/0.1 (+https://github.com/vijaygopalbalasa/memoline)
ALLOW_7702_SENDERS=true
CRON_SECRET=
# Required in production: the canonical public URL of this deployment (e.g. https://memoline-one.vercel.app).
# /api/auth/verify uses its host as the SIWE `domain` to check the signed message against, instead
# of the request's Host header — the request Host is attacker-influenced and only safe to trust
# outside production. Left unset in production, sign-in falls back to Host and logs a warning.
NEXT_PUBLIC_APP_URL=
# scripts/testnet/.env (git-ignored): PRIVATE_KEY, ADDRESS, ARC_TESTNET_RPC

# Optional, public pages. A real payout's transaction hash shown on the landing page as proof; the address
# used for the live example; the payer the public check's sample file is simulated from.
# PROOF_TX_HASH=0x...
# EXAMPLE_ADDRESS=0x...
# SAMPLE_SENDER=0x...
