# scripts/testnet/.env (git-ignored): PRIVATE_KEY, ADDRESS, ARC_TESTNET_RPC
# Arc's public RPCs return Cloudflare 1010 without an explicit User-Agent.
ARC_RPC_PRIMARY=https://rpc.mainnet.arc.io
ARC_RPC_FALLBACK=https://rpc.quicknode.mainnet.arc.io
ARC_TESTNET_RPC_PRIMARY=https://rpc.testnet.arc.io
ARC_TESTNET_RPC_FALLBACK=https://rpc.quicknode.testnet.arc.io
RPC_USER_AGENT=memoline/0.1 (+https://github.com/vijaygopalbalasa/memoline)
